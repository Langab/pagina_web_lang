background-color: null;
font-style: inherit;">6_371_000</span>  <span class="co" style="color: #5E5E5E;
background-color: null;
font-style: inherit;"># radio de la Tierra en metros</span></span>
<span id="cb8-3">    p1, p2 <span class="op" style="color: #5E5E5E;
background-color: null;
font-style: inherit;">=</span> math.radians(lat1), math.radians(lat2)</span>
