<th>Portal</th>
<th>Técnica</th>
<th>Dificultad</th>
</tr>
</thead>
<tbody>
<tr class="odd">
<td>Portal Inmobiliario</td>
<td><code>requests</code> + HTML estático</td>
<td>🟢 La fuente principal</td>
</tr>
<tr class="even">
<td>Chilepropiedades</td>
<td><code>requests</code> + HTML estático</td>
<td>🟢 Rápido y completo</td>
</tr>
<tr class="odd">
<td>Yapo</td>
<td><strong>Scrapling/Camoufox</strong> (navegador sigiloso)</td>
<td>🟡 Bloquea <code>requests</code>; ~40 s/página</td>
</tr>
<tr class="even">
<td>TocToc / GoPlaceIt</td>
<td>Interceptar su API interna (XHR)</td>
<td>🔴 Pendiente</td>
</tr>
<tr class="odd">
<td>Facebook Marketplace</td>
<td>Import manual por CSV</td>
<td>✋ Su scraping viola los ToS</td>
</tr>
